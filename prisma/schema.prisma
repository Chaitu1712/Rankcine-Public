generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ranker")
  createdAt DateTime @default(now())
}

model InfluencerApplication {
  id            String   @id @default(cuid())
  fullName      String
  handle        String
  email         String   @unique
  phone         String
  country       String
  niche         String
  audienceRange String
  about         String   @db.Text
  whyJoin       String   @db.Text
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}